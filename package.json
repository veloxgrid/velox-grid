{
  "name": "velox-grid",
  "version": "0.1.0",
  "description": "A fast, lightweight, and framework-agnostic data grid library",
  "main": "dist/velox-grid.js",
  "module": "dist/velox-grid.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "grid",
    "data-grid",
    "table",
    "datagrid",
    "vanilla",
    "typescript",
    "framework-agnostic"
  ],
  "author": "bumki",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bumki/velox-grid.git"
  },
  "bugs": {
    "url": "https://github.com/bumki/velox-grid/issues"
  },
  "homepage": "https://github.com/bumki/velox-grid#readme"
}
